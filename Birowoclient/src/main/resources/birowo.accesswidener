accessWidener	v2	named

# The client builds its own render layer for lines that ignore the depth of the world.
# RenderLayer.of is the only way to build one, and it is not public.
accessible	method	net/minecraft/client/render/RenderLayer	of	(Ljava/lang/String;Lnet/minecraft/client/render/RenderSetup;)Lnet/minecraft/client/render/RenderLayer;

# The free camera puts the camera somewhere else. The place and the direction of the camera are
# protected, so that the game alone may move it.
accessible	method	net/minecraft/client/render/Camera	setPos	(DDD)V
accessible	method	net/minecraft/client/render/Camera	setRotation	(FF)V

# The interface draws its shapes as a mesh of its own, so that its edges are smooth and not
# stepped along the pixels. The state of the interface is where those shapes are put, and it is
# not public.
accessible	field	net/minecraft/client/gui/DrawContext	state	Lnet/minecraft/client/gui/render/state/GuiRenderState;

# The mesh of the interface has to be cut by the same scissors as the shapes of the game, or it
# would be drawn over the parts of the interface that are meant to be hidden.
accessible	field	net/minecraft/client/gui/DrawContext	scissorStack	Lnet/minecraft/client/gui/DrawContext$ScissorStack;
accessible	class	net/minecraft/client/gui/DrawContext$ScissorStack
